{
  "name": "cue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild apps/desktop/electron/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.js && esbuild apps/desktop/electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "start": "electron dist-electron/main.js",
    "test": "node --import tsx --test packages/**/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "^39.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.21",
    "tsx": "^4.20.0",
    "esbuild": "^0.27.0"
  },
  "main": "dist-electron/main.js"
}
